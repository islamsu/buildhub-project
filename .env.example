# BuildHub environment configuration.
#
# Copy to `.env` for local development. NEVER commit a filled-in .env — the
# .gitignore already excludes it.
#
# Variables marked REQUIRED are validated at boot: production refuses to start
# without them (server/_core/env.ts). Development only warns.

# ── REQUIRED ────────────────────────────────────────────────────────────────

# Signs and verifies session JWTs. Minimum 32 characters.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=

# MySQL/MariaDB connection string.
DATABASE_URL=mysql://user:password@localhost:3306/buildhub

# ── Authentication ──────────────────────────────────────────────────────────

# Public origin of this deployment, e.g. https://buildhub.eg (no trailing
# slash). Used to build links inside outbound email. Password reset reports
# itself unavailable until this is set — deriving it from the request's Host
# header would let an attacker have a reset link pointing at their own domain
# mailed to a victim.
APP_BASE_URL=

# OAuth provider base URL. Optional since Slice 3: email + password sign-in
# works without it. Logged as an error at startup when unset, and
# `auth.capabilities` reports OAuth sign-in as unavailable so the UI hides it.
OAUTH_SERVER_URL=
# Application identifier embedded in issued session tokens. Optional.
#
# When set, a session token is accepted only if it carries this exact value, so
# two apps sharing a JWT_SECRET cannot redeem each other's sessions. When unset
# there is nothing to compare against and any appId is accepted - JWT_SECRET is
# the trust boundary either way.
#
# It used to be load-bearing by accident: tokens were rejected unless appId was
# non-empty, while nothing ever compared it, so leaving this blank produced a
# server that reported a successful sign-up, set the cookie, and then treated
# every subsequent request as anonymous.
VITE_APP_ID=
# openId of the platform owner, used for owner notifications.
OWNER_OPEN_ID=

# ── First administrator ─────────────────────────────────────────────────────
# Creates the FIRST Super Admin at startup, and only if no administrator exists
# yet. Idempotent: once one exists these are inert, so a restart or redeploy
# cannot reset anybody's password. It CREATES an account rather than promoting a
# matching one, so pointing it at somebody else's email grants them nothing.
#
# Set all three together, deploy once, then UNSET them.
#
# NEVER prefix these VITE_. Vite inlines VITE_-prefixed variables into the
# client bundle at build time, which would publish the password to every
# visitor. The password must be at least 12 characters.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=

# ── File storage ────────────────────────────────────────────────────────────
# Two interchangeable backends. Not validated at boot: uploads throw a clear
# error on first use if neither is set, so a deployment that does not use
# uploads still starts.
#
# S3 takes precedence when S3_BUCKET, S3_ACCESS_KEY_ID and S3_SECRET_ACCESS_KEY
# are all present. Any S3-compatible provider works — Vultr Object Storage,
# AWS S3, MinIO, Backblaze B2 — only the endpoint and credentials differ.
#
# Example for Vultr Object Storage:
#   S3_ENDPOINT=https://ewr1.vultrobjects.com
#   S3_REGION=ewr1
#   S3_BUCKET=buildhub-uploads
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Virtual-host addressing needs a wildcard certificate on the endpoint, which
# most non-AWS providers do not have. Leave unset (path style) unless using AWS.
S3_FORCE_PATH_STYLE=

# The Manus platform's LLM and storage gateway.
#
# TWO consumers, which is easy to miss:
#   - object storage, only when no S3 bucket is set; and
#   - the AI assistant at /ai, ALWAYS - server/_core/llm.ts sends every chat
#     request to ${BUILT_IN_FORGE_API_URL}/v1/chat/completions, defaulting to
#     https://forge.manus.im when the URL is empty.
#
# Leave the key unset and auth.capabilities reports aiAssistant false, so /ai
# tells the visitor the assistant is unavailable instead of offering tools that
# cannot answer.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# ── Optional ────────────────────────────────────────────────────────────────

# Port to bind. Production binds exactly this port or exits; development scans
# upward if it is busy.
PORT=3000

# NOT the AI assistant's key, despite the name. Only server/openaiIntegration.ts
# reads this, and nothing in the running application imports that module - /ai
# goes through BUILT_IN_FORGE_API_KEY above. Setting this alone leaves the AI
# assistant unavailable.
OPENAI_API_KEY=

# ── Database transport security ─────────────────────────────────────────────
# Production defaults to `require`; development defaults to `disable` so a
# socket-local MariaDB works without ceremony. A managed database reached over
# a network MUST use `require` - the previous code opened an unencrypted
# connection whenever the URL carried no ssl parameters.
#
#   require   verify the server certificate (production default)
#   disable   plain connection (development default)
DATABASE_SSL=

# CA bundle for the managed database, since providers issue their own.
# Accepts either the PEM contents inline or a path to the .pem file.
DATABASE_CA_CERT=

# ── Outbound email (SMTP) ───────────────────────────────────────────────────
# Any provider that speaks SMTP works - SES, Postmark, Resend, Mailgun,
# SendGrid, Brevo, or a self-hosted relay. Leave SMTP_HOST unset and password
# reset reports itself unavailable rather than pretending to send.
#
# SMTP_FROM must be on a domain the provider has verified, with SPF, DKIM and
# DMARC records published, or messages will be rejected or land in spam.

SMTP_HOST=
SMTP_PORT=587
# Defaults to true on port 465 (implicit TLS), false on 587 (STARTTLS, which is
# then REQUIRED - the connection is never allowed to continue in plaintext).
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Development only. Lets the app talk to a local relay (MailHog, Mailpit) that
# speaks no TLS. IGNORED in production, where STARTTLS is always required.
SMTP_ALLOW_INSECURE=
